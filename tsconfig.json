{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "apps/**/*.ts",
    "contracts/analysis/**/*.ts",
    "contracts/analysis/**/*.d.ts",
    "services/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.d.ts"
  ]
}
