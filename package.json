{
  "name": "agent-shield-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/verify.ts",
    "selftest": "bun scripts/selftest.ts",
    "test": "bun test",
    "check:integration": "bun scripts/verify-bettor-integration.ts",
    "check:all": "bun run check && bun run selftest && bun run check:integration && bunx tsc --noEmit"
  },
  "type": "module"
}
